<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#222B47" />
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="8dp">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:angle="0" android:startColor="#1C8FD6" android:endColor="#35DFFF"/>
                <corners android:radius="4dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
