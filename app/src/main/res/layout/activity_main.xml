<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/fp_bg" android:clipToPadding="false">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="vertical" android:padding="20dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingBottom="18dp">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
          android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Touch Animation" android:textColor="@color/fp_accent" android:textSize="30sp"
            android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Choose your fingerprint style and customize the experience"
            android:textColor="@color/fp_muted" android:textSize="13sp" android:paddingTop="2dp"/>
      </LinearLayout>
      <FrameLayout android:layout_width="48dp" android:layout_height="48dp"
          android:layout_marginStart="12dp" android:clipChildren="false">
        <ImageButton android:id="@+id/infoButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/info_btn_bg"
            android:src="@drawable/ic_info" android:contentDescription="About and update"
            android:scaleType="center"/>
        <View android:id="@+id/updateDot" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_gravity="top|end" android:background="@drawable/update_dot"
            android:visibility="gone"/>
      </FrameLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" app:cardBackgroundColor="@color/fp_card"
        app:strokeColor="@color/fp_stroke" app:strokeWidth="1dp" app:cardCornerRadius="22dp"
        app:cardElevation="0dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ICON" android:textColor="@color/fp_accent" android:textSize="12sp"
            android:textStyle="bold" android:letterSpacing="0.12" android:paddingBottom="10dp"/>
        <Spinner android:id="@+id/catalogSpinner" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone"/>
        <GridLayout android:id="@+id/iconGrid" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
            android:columnCount="4" android:alignmentMode="alignMargins"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" app:cardBackgroundColor="@color/fp_card"
        app:strokeColor="@color/fp_stroke" app:strokeWidth="1dp" app:cardCornerRadius="22dp"
        app:cardElevation="0dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="✦  ANIMATION PREVIEW" android:textColor="@color/fp_accent" android:textSize="12sp"
            android:textStyle="bold" android:letterSpacing="0.12" android:paddingBottom="10dp"/>
        <Spinner android:id="@+id/animSpinner" android:layout_width="match_parent"
            android:layout_height="52dp" android:background="@drawable/spinner_bg"
            android:popupBackground="@drawable/popup_bg" android:dropDownVerticalOffset="6dp"
            android:paddingStart="8dp"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="190dp"
            android:layout_marginTop="12dp" android:padding="0dp"
            android:clipChildren="false" android:clipToPadding="false">
          <View android:layout_width="170dp" android:layout_height="170dp"
              android:layout_gravity="center" android:background="@drawable/lock_preview_bg"/>
          <ImageView android:id="@+id/animPreview"
              android:layout_width="170dp" android:layout_height="170dp"
              android:layout_gravity="center" android:scaleType="fitCenter"
              android:contentDescription="animation preview"/>
        </FrameLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" app:cardBackgroundColor="@color/fp_card"
        app:strokeColor="@color/fp_stroke" app:strokeWidth="1dp" app:cardCornerRadius="22dp"
        app:cardElevation="0dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="OPTIONS" android:textColor="@color/fp_accent" android:textSize="12sp"
            android:textStyle="bold" android:letterSpacing="0.12" android:paddingBottom="10dp"/>
        <Switch android:id="@+id/rippleEnabled" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Show icon on sensor"
            android:textColor="@color/fp_text" android:textSize="15sp" android:minHeight="48dp" android:checked="true"/>
        <Switch android:id="@+id/hideBgEnabled" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Hide black circle behind icon"
            android:textColor="@color/fp_text" android:textSize="15sp" android:minHeight="48dp"/>
        <Switch android:id="@+id/hapticEnabled" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Haptic feedback"
            android:textColor="@color/fp_text" android:textSize="15sp" android:minHeight="48dp" android:checked="true"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" app:cardBackgroundColor="@color/fp_card"
        app:strokeColor="@color/fp_stroke" app:strokeWidth="1dp" app:cardCornerRadius="22dp"
        app:cardElevation="0dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">
        <FrameLayout android:layout_width="170dp" android:layout_height="170dp"
            android:clipChildren="false" android:clipToPadding="false">
          <View android:layout_width="match_parent" android:layout_height="match_parent"
              android:background="@drawable/lock_preview_bg"/>
          <ImageView android:id="@+id/fingerprintPreviewImg"
              android:layout_width="96dp" android:layout_height="96dp"
              android:layout_gravity="center" android:scaleType="fitCenter"
              android:contentDescription="preview"/>
        </FrameLayout>
        <TextView android:id="@+id/fingerprintPreview" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:paddingTop="14dp" android:text="AOSP"
            android:textColor="@color/fp_text" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center"
            android:text="Pick an icon, then Save &amp; Apply" android:textColor="@color/fp_muted"
            android:textSize="13sp" android:paddingTop="4dp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="14dp" app:cardBackgroundColor="@color/fp_card"
        app:strokeColor="@color/fp_stroke" app:strokeWidth="1dp" app:cardCornerRadius="22dp"
        app:cardElevation="0dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
          android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SIZE &amp; SPEED" android:textColor="@color/fp_accent" android:textSize="12sp"
            android:textStyle="bold" android:letterSpacing="0.12" android:paddingBottom="10dp"/>
        <TextView android:id="@+id/iconScaleLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Lock screen icon size: 180%"
            android:textColor="@color/fp_muted" android:textSize="13sp" android:paddingTop="0dp"/>
        <SeekBar android:id="@+id/iconScaleSeek" style="@style/FP.Slider" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:min="60" android:max="220"
            android:progress="180"/>
        <TextView android:id="@+id/sizeLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Touch animation size: 90%"
            android:textColor="@color/fp_muted" android:textSize="13sp" android:paddingTop="14dp"/>
        <SeekBar android:id="@+id/sizeSeek" style="@style/FP.Slider" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="100" android:progress="90"/>
        <TextView android:id="@+id/speedLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Animation speed: 900 ms"
            android:textColor="@color/fp_muted" android:textSize="13sp" android:paddingTop="14dp"/>
        <SeekBar android:id="@+id/speedSeek" style="@style/FP.Slider" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="1600" android:progress="500"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton" android:layout_width="match_parent"
        android:layout_height="58dp" android:text="Save &amp; Apply"
        android:textColor="#000000" android:textSize="16sp" android:textStyle="bold"
        app:backgroundTint="@color/fp_accent" app:cornerRadius="18dp"/>
    <Space android:layout_width="match_parent" android:layout_height="12dp"/>
  </LinearLayout>
</ScrollView>
