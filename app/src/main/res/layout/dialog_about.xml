<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="ABOUT" android:textColor="@color/fp_accent" android:textSize="12sp"
      android:textStyle="bold" android:letterSpacing="0.12" android:paddingBottom="10dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="FingerFlux" android:textColor="@color/fp_text" android:textSize="22sp"
      android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Custom fingerprint icons and touch animations for the AOSP lock screen."
      android:textColor="@color/fp_muted" android:textSize="13sp" android:paddingTop="4dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="DEVELOPER" android:textColor="@color/fp_muted" android:textSize="11sp"
      android:letterSpacing="0.1" android:paddingTop="16dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Faroque Tech" android:textColor="@color/fp_text" android:textSize="16sp"
      android:textStyle="bold" android:paddingTop="2dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="inspired by" android:textColor="@color/fp_muted" android:textSize="13sp"
      android:fontFamily="serif" android:textStyle="italic" android:letterSpacing="0.06"
      android:paddingTop="14dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Fingerprint Catalog" android:textColor="@color/fp_accent" android:textSize="19sp"
      android:fontFamily="sans-serif-medium" android:textStyle="bold" android:letterSpacing="0.05"
      android:shadowColor="#8035DFFF" android:shadowRadius="14" android:shadowDx="0" android:shadowDy="0"/>
  <View android:layout_width="match_parent" android:layout_height="1dp"
      android:layout_marginTop="20dp" android:layout_marginBottom="20dp"
      android:background="@color/fp_stroke"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="UPDATE" android:textColor="@color/fp_accent" android:textSize="12sp"
      android:textStyle="bold" android:letterSpacing="0.12" android:paddingBottom="10dp"/>
  <TextView android:id="@+id/aboutVersion" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:text="Version"
      android:textColor="@color/fp_text" android:textSize="15sp" android:textStyle="bold"/>
  <TextView android:id="@+id/updateStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Check if a newer version is available."
      android:textColor="@color/fp_muted" android:textSize="13sp" android:paddingTop="2dp"/>
  <com.google.android.material.button.MaterialButton
      android:id="@+id/checkUpdateButton" android:layout_width="match_parent"
      android:layout_height="52dp" android:layout_marginTop="14dp" android:text="Check for update"
      android:textColor="#000000" android:textStyle="bold"
      app:backgroundTint="@color/fp_accent" app:cornerRadius="18dp"/>
  <View android:layout_width="match_parent" android:layout_height="1dp"
      android:layout_marginTop="20dp" android:layout_marginBottom="20dp"
      android:background="@color/fp_stroke"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="CONNECT &amp; SUPPORT" android:textColor="@color/fp_accent" android:textSize="12sp"
      android:textStyle="bold" android:letterSpacing="0.12" android:paddingBottom="10dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Enjoying the app? Join the community or support its development."
      android:textColor="@color/fp_muted" android:textSize="13sp" android:paddingBottom="12dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/telegramButton" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp" android:layout_height="92dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="12dp" android:paddingBottom="10dp" app:iconPadding="6dp" android:layout_weight="1"
        android:layout_marginEnd="6dp" android:text="Telegram" android:textSize="12sp"
        android:textColor="@color/fp_text" app:icon="@drawable/ic_telegram"
        app:iconTint="@null" app:iconGravity="top" app:iconSize="28dp"
        app:strokeColor="@color/fp_stroke" app:cornerRadius="20dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/donateButton" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp" android:layout_height="92dp" android:insetTop="0dp" android:insetBottom="0dp" android:paddingTop="12dp" android:paddingBottom="10dp" app:iconPadding="6dp" android:layout_weight="1"
        android:layout_marginStart="6dp" android:text="Donate" android:textSize="12sp"
        android:textColor="@color/fp_text" app:icon="@drawable/ic_donate"
        app:iconTint="@null" app:iconGravity="top" app:iconSize="28dp"
        app:strokeColor="@color/fp_stroke" app:cornerRadius="20dp"/>
  </LinearLayout>
</LinearLayout>
</ScrollView>
